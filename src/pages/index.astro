<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grace's Chinese Classroom · Learn Chinese in Summer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@300;400;500;600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --sky-top: #bfe3f0;
      --sky-mid: #d9edd8;
      --sky-bottom: #f3f8e8;
      --grass-dark: #5f9a52;
      --grass-mid: #82b968;
      --grass-light: #a9d189;
      --sun: #f6d776;
      --sun-glow: #fbe9b0;
      --cream: #fffcf3;
      --ink: #33402f;
      --ink-soft: #5c6b53;
      --brown: #a6743f;
      --brown-dark: #8a5f30;
      --card: #fffef9;
      --shadow: 0 12px 30px -12px rgba(60,80,40,0.25);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      color: var(--ink);
      background: var(--cream);
      overflow-x: hidden;
    }
    h1, h2, h3, .serif { font-family: 'Fraunces', serif; }
    .brush { font-family: 'Caveat', cursive; color: var(--brown-dark); font-size: 1.15em; font-weight: 600; }
    a { color: inherit; }
    img { max-width: 100%; display: block; }

    /* ---------- NAV ---------- */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 6vw;
      background: rgba(255,252,243,0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(95,154,82,0.15);
    }
    .logo {
      display: flex; align-items: center; gap: 8px;
      font-family: 'Fraunces', serif;
      font-weight: 700; font-size: 20px; color: var(--brown-dark);
      text-decoration: none; position: relative; user-select: none;
    }
    .logo svg { width: 28px; height: 28px; }
    .nav-links {
      display: flex; gap: 28px; list-style: none; margin: 0; padding: 0;
      font-size: 15px; font-weight: 500; color: var(--ink-soft);
    }
    .nav-links a { text-decoration: none; position: relative; padding-bottom: 2px; }
    .nav-links a::after {
      content: ''; position: absolute; left: 0; bottom: -3px; width: 0; height: 2px;
      background: var(--grass-dark); transition: width .25s ease;
    }
    .nav-links a:hover::after { width: 100%; }
    .nav-cta {
      background: var(--brown); color: #fff; padding: 9px 20px; border-radius: 999px;
      font-size: 14px; font-weight: 500; text-decoration: none; box-shadow: var(--shadow);
      white-space: nowrap;
    }
    @media(max-width:820px) { .nav-links { display: none; } }

    /* ---------- HERO ---------- */
    .hero {
      position: relative; min-height: 90vh;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 55%, var(--sky-bottom) 100%);
      overflow: hidden; padding-top: 80px;
    }
    .sun {
      position: absolute; top: 9%; right: 14%;
      width: 120px; height: 120px; border-radius: 50%;
      background: radial-gradient(circle, var(--sun) 0%, var(--sun-glow) 55%, rgba(251,233,176,0) 75%);
    }
    .cloud { position: absolute; opacity: .9; }
    .cloud svg { width: 100%; height: 100%; display: block; }
    .cloud-1 { top: 14%; left: -10%; width: 220px; animation: drift 55s linear infinite; }
    .cloud-2 { top: 24%; left: -20%; width: 150px; animation: drift 70s linear infinite; animation-delay: -20s; opacity: .75; }
    .cloud-3 { top: 8%; left: -15%; width: 110px; animation: drift 40s linear infinite; animation-delay: -8s; opacity: .6; }
    @keyframes drift { from { transform: translateX(0); } to { transform: translateX(140vw); } }

    .hero-content { position: relative; z-index: 5; text-align: center; padding: 0 20px; max-width: 720px; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 14px; letter-spacing: .08em; color: var(--brown-dark);
      background: rgba(255,255,255,.55); padding: 6px 16px; border-radius: 999px;
      margin-bottom: 22px; border: 1px solid rgba(166,116,63,0.25);
    }
    .hero h1 { font-size: clamp(34px,6vw,58px); line-height: 1.25; margin: 0 0 18px; color: #3c4a30; font-weight: 700; }
    .hero p.lead { font-size: 17px; color: var(--ink-soft); line-height: 1.9; margin: 0 auto 34px; max-width: 520px; }
    .hero-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .btn-primary, .btn-ghost {
      padding: 13px 28px; border-radius: 999px; font-size: 15px; font-weight: 500;
      text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; display: inline-block;
    }
    .btn-primary { background: var(--brown); color: #fff; box-shadow: var(--shadow); }
    .btn-primary:hover { transform: translateY(-2px); }
    .btn-ghost { background: rgba(255,255,255,.6); color: var(--ink); border: 1px solid rgba(95,154,82,.35); }
    .btn-ghost:hover { background: #fff; }

    /* ---------- 通用 SECTION 样式 ---------- */
    section.block { position: relative; padding: 80px 6vw; }
    .band-sky { background: linear-gradient(180deg, #eef7ea 0%, #f3f8e8 100%); }
    .band-arcade {
      background: linear-gradient(180deg, #f0f7ec 0%, #e3f0dc 100%);
      border-top: 2px dashed rgba(95, 154, 82, 0.2);
      border-bottom: 2px dashed rgba(95, 154, 82, 0.2);
    }
    .band-cream { background: var(--cream); }
    .band-green { background: linear-gradient(180deg, #eaf4e2 0%, #f7f2e2 100%); }

    .section-head { text-align: center; max-width: 640px; margin: 0 auto 48px; }
    .section-tag { display: inline-block; font-size: 13px; letter-spacing: .12em; color: var(--grass-dark); font-weight: 600; margin-bottom: 12px; text-transform: uppercase; }
    .section-head h2 { font-size: clamp(26px,4vw,38px); margin: 0 0 14px; color: #3c4a30; }
    .section-head p { color: var(--ink-soft); line-height: 1.8; margin: 0; font-size: 15.5px; }

    /* ---------- 🎮 游戏入口板块 ---------- */
    .games-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 32px;
      max-width: 1120px;
      margin: 0 auto;
    }
    .game-card {
      background: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(60, 80, 40, 0.08);
      border: 1px solid rgba(95, 154, 82, 0.2);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: flex;
      flex-direction: column;
    }
    .game-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px -10px rgba(60, 80, 40, 0.22);
    }
    .game-card-banner {
      height: 110px;
      position: relative;
      padding: 16px;
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
    }
    .game-badge {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(4px);
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: var(--ink);
    }
    .game-card-body {
      padding: 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .game-category {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }
    .game-card-body h3 {
      font-size: 22px;
      margin: 0 0 10px;
      color: #3c4a30;
      font-family: 'Fraunces', serif;
    }
    .game-card-body p {
      font-size: 14.5px;
      color: var(--ink-soft);
      line-height: 1.7;
      margin: 0 0 24px;
      flex-grow: 1;
    }
    .game-play-btn {
      display: block;
      text-align: center;
      background: var(--grass-dark);
      color: #ffffff;
      padding: 12px 24px;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      transition: background 0.2s ease, transform 0.2s ease;
      box-shadow: 0 4px 12px rgba(95, 154, 82, 0.3);
    }
    .game-play-btn:hover {
      background: #4a823e;
      transform: scale(1.02);
    }

    /* ---------- ABOUT ME ---------- */
    .about-wrap { display: grid; grid-template-columns: 280px 1fr; gap: 56px; align-items: center; max-width: 980px; margin: 0 auto; }
    .about-portrait {
      position: relative; width: 100%; aspect-ratio: 1/1; border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #fff 0%, #fdf3d9 40%, var(--grass-light) 100%);
      display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow); border: 6px solid #fff;
    }
    .about-portrait svg { width: 78%; }
    .about-text h3 { font-size: 26px; margin: 0 0 14px; color: #3c4a30; }
    .about-text p { color: var(--ink-soft); line-height: 1.95; font-size: 15.5px; margin: 0 0 14px; }
    .about-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
    .about-tags span { background: #fff; border: 1px solid rgba(95,154,82,.3); color: var(--grass-dark); padding: 6px 14px; border-radius: 999px; font-size: 13.5px; font-weight: 500; }
    @media(max-width:760px) { .about-wrap { grid-template-columns: 1fr; text-align: center; } .about-portrait { width: 220px; margin: 0 auto; } .about-tags { justify-content: center; } }

    /* ---------- RESOURCE CARDS ---------- */
    .level-header { display: flex; align-items: center; gap: 16px; justify-content: center; margin-bottom: 12px; }
    .level-badge { width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Fraunces',serif; font-weight: 700; color: #fff; font-size: 18px; }
    .badge-beginner { background: var(--grass-mid); }
    .badge-advanced { background: var(--brown); }

    .card-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 22px; max-width: 1120px; margin: 0 auto; }
    @media(max-width:980px) { .card-grid { grid-template-columns: repeat(2,1fr); } }
    @media(max-width:560px) { .card-grid { grid-template-columns: 1fr; } }

    .card {
      background: var(--card); border-radius: 20px; padding: 28px 22px;
      box-shadow: var(--shadow); border: 1px solid rgba(95,154,82,.12);
      transition: transform .25s ease, box-shadow .25s ease, opacity .5s ease;
      opacity: 0; transform: translateY(24px);
    }
    .card.in-view { opacity: 1; transform: translateY(0); }
    .card:hover { transform: translateY(-6px); box-shadow: 0 18px 34px -14px rgba(60,80,40,.32); }
    .card .icon-wrap { width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
    .card h4 { margin: 0 0 8px; font-size: 17px; font-family: 'Fraunces',serif; color: #3c4a30; }
    .card p { margin: 0 0 16px; font-size: 13.8px; color: var(--ink-soft); line-height: 1.7; }
    .card .card-link { font-size: 13.5px; font-weight: 600; color: var(--brown-dark); text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }

    .icon-yellow { background: #fdf0c8; color: #c99a3a; }
    .icon-green { background: #dcefd0; color: #4f8a45; }
    .icon-blue { background: #d8ecf2; color: #3f8fa3; }
    .icon-brown { background: #f0e0c9; color: #a06a34; }

    /* ---------- GALLERY ---------- */
    .gallery { display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; max-width: 1120px; margin: 0 auto; }
    @media(max-width:900px) { .gallery { grid-template-columns: repeat(2,1fr); } }
    .gallery-item { position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4/5; box-shadow: var(--shadow); }
    .gallery-item .ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
    .gallery-item .cap { position: absolute; bottom: 0; left: 0; right: 0; padding: 14px 16px 12px; background: linear-gradient(0deg, rgba(50,60,40,.72), rgba(50,60,40,0)); color: #fff; font-size: 13.5px; font-weight: 500; }

    /* ---------- FOOTER ---------- */
    .cta-block { position: relative; text-align: center; padding: 80px 6vw; background: linear-gradient(180deg, #eef7ea 0%, #cfe8c6 100%); }
    .cta-block h2 { font-size: clamp(26px,4vw,36px); margin: 0 0 16px; color: #33402f; }
    .cta-block p { color: var(--ink-soft); line-height: 1.9; margin: 0 0 32px; font-size: 15.5px; }

    footer { background: #3c4a30; color: #e7ecdf; padding: 44px 6vw 30px; text-align: center; font-size: 13.5px; }
    footer .foot-logo { font-family: 'Fraunces',serif; font-size: 18px; margin-bottom: 10px; }
    footer .foot-links { display: flex; gap: 24px; justify-content: center; margin: 16px 0; flex-wrap: wrap; }
    footer a { text-decoration: none; color: #dfe6d3; }
  </style>
</head>
<body>

<!-- ================================================================ -->
<!-- 顶部导航栏：链接顺序已跟下面板块顺序保持一致 -->
<!-- ================================================================ -->
<nav>
  <a href="#top" class="logo">
    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3C9 7 6 9 6 13a6 6 0 0012 0c0-4-3-6-6-10z" fill="#82b968"/></svg>
    Grace's Chinese Classroom
  </a>
  <ul class="nav-links">
    <li><a href="#arcade">🎮 游戏合集</a></li>
    <li><a href="#beginner">Beginner</a></li>
    <li><a href="#advanced">Advanced</a></li>
    <li><a href="#gallery">Student Work</a></li>
    <li><a href="#about">About Me</a></li>
  </ul>
  <a href="#contact" class="nav-cta">Online Classes</a>
</nav>

<!-- ================================================================ -->
<!-- 第一部分｜Hero 首屏欢迎语，保留 "Hi, I'm Grace" -->
<!-- ================================================================ -->
<header class="hero" id="top">
  <div class="sun"></div>
  <div class="hero-content">
    <span class="eyebrow">🌿 Welcome to a summer Chinese classroom</span>
    <h1>Hi, I'm <span class="brush">Grace</span><br>Let's learn Chinese through stories and play</h1>
    <p class="lead">Here you'll find the slides, worksheets, activities and mini games I use in class.</p>
    <div class="hero-btns">
      <a href="#arcade" class="btn-primary">🎮 Games</a>
      <a href="#beginner" class="btn-ghost">Learning resources</a>
    </div>
  </div>
</header>

<!-- ================================================================ -->
<!-- 第二部分｜游戏合集入口                                            -->
<!-- 这里不再直接展示每个游戏卡片，只放一个入口按钮，                   -->
<!-- 点击后跳转到单独的"游戏合集页面"（建议路径：/games）。             -->
<!-- 你需要在 src/pages/games/ 下新建一个页面来展示 gamesList 里的游戏。 -->
<!-- 以后新增游戏：只需要改那个独立页面，首页完全不用动。               -->
<!-- ================================================================ -->
<section class="block band-arcade" id="arcade">
  <div class="section-head">
    <span class="section-tag">Interactive Arcade</span>
    <h2>中文互动游戏大厅 🎮</h2>
    <p>用声音和互动小游戏练习拼音、声调与汉字笔画，点击下方按钮查看所有已上线的游戏。</p>
  </div>
  <div style="text-align:center;">
    <a href="/games" class="btn-primary" style="font-size:17px; padding:16px 40px;">🎮 进入游戏合集 →</a>
  </div>
</section>

<!-- ================================================================ -->
<!-- 第三部分｜Beginner Chinese 资源库                                 -->
<!-- 数据来源：上方 beginnerResources 数组                             -->
<!-- 新增资源：在 beginnerResources 数组里加一个对象即可                -->
<!-- ================================================================ -->
<section class="block band-cream" id="beginner">
  <div class="section-head">
    <div class="level-header"><span class="level-badge badge-beginner">B</span></div>
    <span class="section-tag">Beginner Chinese</span>
    <h2>Beginner Chinese</h2>
  </div>
  <div class="card-grid">
    {beginnerResources.map((item) => (
      <div class="card">
        <div class={`icon-wrap ${item.iconBg}`}>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d={item.iconPath || "M4 3h16v18H4z"} stroke-linecap="round"/>
