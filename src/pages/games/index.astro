---
// ================================================================
// 📌 游戏合集页面
// 这个页面专门展示所有的互动游戏卡片。
// 新增游戏：在下面 gamesList 数组里复制一个对象，改内容即可，
// 首页（index.astro）完全不用跟着改。
// ================================================================
const gamesList = [
  {
    id: "tone-game",
    title: "拼音声调大冒险 🎙️",
    desc: "用声音控制热气球升降！通过准确发音（一声~四声）避开小云朵。",
    category: "声调练习 · 初级",
    badge: "Voice Game",
    link: "/games/tone-game",
    bgGradient: "linear-gradient(135deg, #a8e063 0%, #56ab2f 100%)",
    tagColor: "#4f8a45"
  },
  {
    id: "pinyin-jump",
    title: "拼音跑酷 Jump 🏃‍♂️",
    desc: "大声读出正确的声母或韵母，帮助小马跳过前方的障碍物！",
    category: "拼音辨析 · 初级",
    badge: "Voice Game",
    link: "/games/pinyin-jump",
    bgGradient: "linear-gradient(135deg, #f6d365 0%, #fda085 100%)",
    tagColor: "#a6743f"
  },
  {
    id: "stroke-game",
    title: "汉字笔画大冒险 ✍️",
    desc: "跟随动画按正确的笔顺书写汉字！掌握横竖撇捺，写出一手漂亮的好字。",
    category: "汉字书写 · 基础",
    badge: "Writing Game",
    link: "/games/stroke-game",
    bgGradient: "linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)",
    tagColor: "#d65b74"
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>游戏合集 · Grace's Chinese Classroom</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@300;400;500;600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --sky-top: #bfe3f0; --sky-mid: #d9edd8; --sky-bottom: #f3f8e8;
      --grass-dark: #5f9a52; --grass-mid: #82b968;
      --cream: #fffcf3; --ink: #33402f; --ink-soft: #5c6b53;
      --brown: #a6743f; --brown-dark: #8a5f30;
      --shadow: 0 12px 30px -12px rgba(60,80,40,0.25);
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--cream); }
    h1, h2, h3 { font-family: 'Fraunces', serif; }
    a { color: inherit; text-decoration: none; }

    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 6vw; background: rgba(255,252,243,0.85);
      backdrop-filter: blur(8px); border-bottom: 1px solid rgba(95,154,82,0.15);
    }
    .logo { display: flex; align-items: center; gap: 8px; font-family: 'Fraunces', serif; font-weight: 700; font-size: 20px; color: var(--brown-dark); }
    .back-link { font-size: 14px; font-weight: 500; color: var(--ink-soft); display: flex; align-items: center; gap: 6px; }

    .page-header {
      padding: 140px 6vw 60px;
      text-align: center;
      background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 55%, var(--sky-bottom) 100%);
    }
    .page-header h1 { font-size: clamp(30px,5vw,46px); margin: 0 0 14px; color: #3c4a30; }
    .page-header p { color: var(--ink-soft); font-size: 16px; max-width: 560px; margin: 0 auto; line-height: 1.8; }

    .games-wrap { padding: 60px 6vw 100px; }
    .games-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 32px; max-width: 1120px; margin: 0 auto;
    }
    .game-card {
      background: #ffffff; border-radius: 24px; overflow: hidden;
      box-shadow: 0 10px 25px rgba(60, 80, 40, 0.08);
      border: 1px solid rgba(95, 154, 82, 0.2);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: flex; flex-direction: column;
    }
    .game-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px -10px rgba(60, 80, 40, 0.22); }
    .game-card-banner { height: 110px; position: relative; padding: 16px; display: flex; align-items: flex-start; justify-content: flex-end; }
    .game-badge { background: rgba(255,255,255,0.9); backdrop-filter: blur(4px); padding: 5px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--ink); }
    .game-card-body { padding: 24px; display: flex; flex-direction: column; flex-grow: 1; }
    .game-category { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .game-card-body h3 { font-size: 22px; margin: 0 0 10px; color: #3c4a30; }
    .game-card-body p { font-size: 14.5px; color: var(--ink-soft); line-height: 1.7; margin: 0 0 24px; flex-grow: 1; }
    .game-play-btn {
      display: block; text-align: center; background: var(--grass-dark); color: #fff;
      padding: 12px 24px; border-radius: 999px; font-weight: 600; font-size: 15px;
      transition: background 0.2s ease, transform 0.2s ease; box-shadow: 0 4px 12px rgba(95, 154, 82, 0.3);
    }
    .game-play-btn:hover { background: #4a823e; transform: scale(1.02); }

    footer { background: #3c4a30; color: #e7ecdf; padding: 40px 6vw 26px; text-align: center; font-size: 13.5px; }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">🌿 Grace's Chinese Classroom</a>
  <a href="/" class="back-link">← 返回首页</a>
</nav>

<header class="page-header">
  <h1>中文互动游戏合集 🎮</h1>
  <p>用声音和互动小游戏练习拼音、声调与汉字笔画，选一个开始吧！</p>
</header>

<section class="games-wrap">
  <div class="games-grid">
    {gamesList.map((game) => (
      <div class="game-card">
        <div class="game-card-banner" style={`background: ${game.bgGradient}`}>
          <span class="game-badge">{game.badge}</span>
        </div>
        <div class="game-card-body">
          <span class="game-category" style={`color: ${game.tagColor}`}>{game.category}</span>
          <h3>{game.title}</h3>
          <p>{game.desc}</p>
          <a href={game.link} class="game-play-btn">立即游玩 ➔</a>
        </div>
      </div>
    ))}
  </div>
</section>

<footer>
  <p>© Grace's Chinese Classroom. All rights reserved.</p>
</footer>

</body>
</html>