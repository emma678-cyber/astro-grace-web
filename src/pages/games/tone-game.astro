---
// src/pages/games/tone-game.astro
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>拼音声调大冒险 · Grace's Chinese Classroom</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #f3f8e8;
      --ink: #33402f;
      --grass: #5f9a52;
    }
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--ink);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    
    /* 游戏顶栏 Header */
    .game-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 5vw;
      background: rgba(255,255,255,0.8);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(95,154,82,0.2);
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      color: var(--grass);
      font-weight: 600;
      font-size: 15px;
      transition: transform 0.2s ease;
    }
    .back-btn:hover { transform: translateX(-3px); }
    .game-title {
      font-family: 'Fraunces', serif;
      font-size: 20px;
      margin: 0;
      color: #3c4a30;
    }

    /* 游戏主体容器 */
    .game-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 20px;
      max-width: 900px;
      margin: 0 auto;
      width: 100%;
      box-sizing: border-box;
    }

    canvas {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 12px 30px -10px rgba(60,80,40,0.2);
      max-width: 100%;
      height: auto;
    }

    .controls {
      margin-top: 20px;
      display: flex;
      gap: 16px;
    }
    .btn {
      background: var(--grass);
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 999px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(95,154,82,0.3);
    }
  </style>
</head>
<body>

  <header class="game-header">
    <a href="/#arcade" class="back-btn">
      <span>⬅️</span> 返回 Grace 的教室
    </a>
    <h1 class="game-title">🎙️ 拼音声调大冒险</h1>
    <div style="width: 100px;"></div> <!-- 保持标题居中的占位 -->
  </header>

  <main class="game-container">
    <canvas id="gameCanvas" width="800" height="480"></canvas>
    
    <div class="controls">
      <button class="btn" id="startBtn">开启麦克风并开始</button>
    </div>
  </main>

  <script>
    // 💡 最佳实践：全局管理音频流与麦克风资源
    let audioStream = null;

    const startBtn = document.getElementById('startBtn');
    
    startBtn.addEventListener('click', async () => {
      try {
        // 请求麦克风权限
        audioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        alert("麦克风启动成功！游戏开始！");
        // 这里放入你的音频处理逻辑（如 AudioContext/Web Speech API）及 Canvas 动画循环
      } catch (err) {
        alert("需要允许麦克风权限才能玩此游戏哦！");
      }
    });

    // 💡 最佳实践：离开当前页面时自动关闭麦克风，释放设备资源
    window.addEventListener('beforeunload', () => {
      if (audioStream) {
        audioStream.getTracks().forEach(track => track.stop());
      }
    });
  </script>
</body>
</html>