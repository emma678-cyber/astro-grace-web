---
import { beginnerTopics } from '../../../data/beginnerTopics.js';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Beginner Chinese Worksheets · Grace's Chinese Classroom</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --sky-top: #bfe3f0; --sky-mid: #d9edd8; --sky-bottom: #f3f8e8;
      --grass-dark: #5f9a52; --grass-mid: #82b968;
      --cream: #fffcf3; --ink: #33402f; --ink-soft: #5c6b53;
      --brown: #a6743f; --brown-dark: #8a5f30;
      --card: #fffef9; --shadow: 0 12px 30px -12px rgba(60,80,40,0.25);
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; color: var(--ink); background: var(--cream); }
    h1, h2 { font-family: 'Fraunces', serif; }
    a { color: inherit; text-decoration: none; }

    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 6vw; background: rgba(255,252,243,0.85);
      backdrop-filter: blur(8px); border-bottom: 1px solid rgba(95,154,82,0.15);
    }
    .logo { font-family: 'Fraunces', serif; font-weight: 700; font-size: 20px; color: var(--brown-dark); }
    .back-link { font-size: 14px; font-weight: 500; color: var(--ink-soft); }

    .page-header {
      padding: 140px 6vw 50px; text-align: center;
      background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 55%, var(--sky-bottom) 100%);
    }
    .page-header h1 { font-size: clamp(28px,4.5vw,42px); margin: 0 0 12px; color: #3c4a30; }
    .page-header p { color: var(--ink-soft); font-size: 15.5px; max-width: 560px; margin: 0 auto; line-height: 1.8; }

    .topics-wrap { padding: 60px 6vw 100px; }
    .topic-grid {
      display: grid; grid-template-columns: repeat(4,1fr); gap: 20px;
      max-width: 1080px; margin: 0 auto;
    }
    @media(max-width:900px) { .topic-grid { grid-template-columns: repeat(2,1fr); } }
    @media(max-width:520px) { .topic-grid { grid-template-columns: 1fr; } }

    .topic-card {
      background: var(--card); border-radius: 18px; padding: 26px 20px;
      box-shadow: var(--shadow); border: 1px solid rgba(95,154,82,.15);
      text-align: center; transition: transform .2s ease, box-shadow .2s ease;
    }
    .topic-card:hover { transform: translateY(-5px); box-shadow: 0 18px 34px -14px rgba(60,80,40,.32); }
    .topic-card h3 { margin: 0 0 4px; font-size: 17px; color: #3c4a30; }
    .topic-card p { margin: 0; font-size: 12.5px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .04em; }

    footer { background: #3c4a30; color: #e7ecdf; padding: 40px 6vw 26px; text-align: center; font-size: 13.5px; }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo">🌿 Grace's Chinese Classroom</a>
  <a href="/" class="back-link">← 返回首页</a>
</nav>

<header class="page-header">
  <h1>Beginner Chinese Worksheets</h1>
  <p>选择一个主题，查看对应的练习资料</p>
</header>

<section class="topics-wrap">
  <div class="topic-grid">
    {beginnerTopics.map((topic) => (
      <a href={`/beginner/worksheets/${topic.slug}`} class="topic-card">
        <h3>{topic.title}</h3>
        <p>{topic.subtitle}</p>
      </a>
    ))}
  </div>
</section>

<footer>
  <p>© Grace's Chinese Classroom. All rights reserved.</p>
</footer>

</body>
</html>