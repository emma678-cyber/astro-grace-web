---
// ================================================================
// 📌 密码保护组件（PasswordGate）
// 用法：把需要密码才能看到的内容，用 <PasswordGate> 包起来即可。
//
// 示例：
// ---
// import PasswordGate from '../components/PasswordGate.astro';
// ---
// <PasswordGate password="xiexie">
//   <a href="/files/beginner/pinyin/worksheet1.pdf">下载声母练习</a>
// </PasswordGate>
//
// 注意：这只是网页前端的简单遮罩，能挡住"随手点开下载"的人，
// 不是真正的服务器级加密。文件本身仍然放在公开位置，
// 知道直接文件网址的人理论上还是能绕过密码访问。
// 如果以后需要更严格的保护，需要用 Cloudflare Functions 做后端验证。
// ================================================================
export interface Props {
  password: string;
  hint?: string;
}
const { password, hint } = Astro.props;
// 给每个组件实例生成一个唯一 ID，避免同一页面用多次时互相冲突
const gateId = `gate-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="password-gate" data-gate-id={gateId} data-password={password}>
  <div class="gate-locked">
    <div class="gate-icon">🔒</div>
    <p class="gate-text">此内容需要密码才能查看</p>
    {hint && <p class="gate-hint">提示：{hint}</p>}
    <div class="gate-input-row">
      <input type="password" class="gate-input" placeholder="请输入密码" />
      <button type="button" class="gate-submit">确认</button>
    </div>
    <p class="gate-error" style="display:none;">密码不对，再试一次～</p>
  </div>
  <div class="gate-content" style="display:none;">
    <slot />
  </div>
</div>

<style>
  .password-gate { margin: 16px 0; }
  .gate-locked {
    background: #fdf9ef;
    border: 1px solid rgba(166,116,63,0.25);
    border-radius: 14px;
    padding: 24px;
    text-align: center;
  }
  .gate-icon { font-size: 28px; margin-bottom: 8px; }
  .gate-text { margin: 0 0 4px; font-weight: 600; color: #3c4a30; }
  .gate-hint { margin: 0 0 14px; font-size: 13px; color: #5c6b53; }
  .gate-input-row { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .gate-input {
    padding: 10px 14px; border-radius: 999px; border: 1px solid rgba(95,154,82,0.35);
    font-size: 14px; min-width: 180px;
  }
  .gate-submit {
    padding: 10px 22px; border-radius: 999px; border: none;
    background: #a6743f; color: #fff; font-size: 14px; font-weight: 500; cursor: pointer;
  }
  .gate-submit:hover { opacity: 0.9; }
  .gate-error { color: #b5442e; font-size: 13px; margin: 10px 0 0; }
</style>

<script>
  // 页面上可能有多个密码保护区块，逐个绑定各自的事件
  document.querySelectorAll('.password-gate').forEach((gate) => {
    const correctPassword = gate.getAttribute('data-password');
    const input = gate.querySelector('.gate-input');
    const button = gate.querySelector('.gate-submit');
    const errorMsg = gate.querySelector('.gate-error');
    const lockedView = gate.querySelector('.gate-locked');
    const contentView = gate.querySelector('.gate-content');

    function tryUnlock() {
      if (input.value === correctPassword) {
        lockedView.style.display = 'none';
        contentView.style.display = 'block';
      } else {
        errorMsg.style.display = 'block';
        input.value = '';
        input.focus();
      }
    }

    button.addEventListener('click', tryUnlock);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') tryUnlock();
    });
  });
</script>